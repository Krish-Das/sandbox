{
    "name": "jwt-bcrypt-sql",
    "private": true,
    "type": "module",
    "scripts": {
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "typecheck": "tsc --noEmit",
        "tsc": "tsc --noEmit",
        "debug": "bun --inspect-wait=localhost:6499/debug",
        "debug:watch": "bun --watch --inspect-wait=localhost:6499/debug",
        "db:migrate": "tsx --env-file=.env src/db/migrate.ts"
    },
    "dependencies": {
        "@neondatabase/serverless": "^1.2.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tsgolint": "^7.0.2003e",
        "tsx": "^4.23.15"
    },
    "peerDependencies": {
        "typescript": "^7"
    }
}